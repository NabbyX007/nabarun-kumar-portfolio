# Copy to .env.local for local development, or add these in Vercel → Project → Settings → Environment Variables.

# Public URL used for canonical, Open Graph, sitemap.xml and robots.txt.
# Optional on Vercel: the production domain is detected automatically. Set it for a custom domain.
VITE_SITE_URL=

# Contact form delivery. Any service that accepts a JSON POST and returns 2xx on success.
#   Formspree:  https://formspree.io/f/<your-form-id>
#   Web3Forms:  https://api.web3forms.com/submit   (also set VITE_CONTACT_ACCESS_KEY)
# Leave empty to fall back to opening a pre-filled email in the visitor's mail app.
VITE_CONTACT_ENDPOINT=
VITE_CONTACT_ACCESS_KEY=
